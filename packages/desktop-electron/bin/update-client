#!/bin/bash -e

# cd into the package root, then use relative paths. The repo checkout lives
# under directories with spaces ("Windows 10 Pro", "Lunch Money"), so an
# absolute ${ROOT} would word-split every unquoted use below; relative paths
# from the (spaced) cwd do not.
cd "$(dirname "$0")/.."

rm -rf build
mkdir -p build
cp -r ../desktop-client/build-electron build/client-build

# Remove the embedded backend for the browser version. Will improve
# this process
rm -rf build/client-build/data
rm -rf build/client-build/*kcab.*
rm -rf build/client-build/*.wasm
rm -rf build/client-build/*.map

# Copy loot-core into build directory
mkdir -p build/loot-core/lib-dist/electron
cp ../loot-core/lib-dist/electron/bundle.desktop.js build/loot-core/lib-dist/electron/bundle.desktop.js
cp ../loot-core/default-db.sqlite build/loot-core/default-db.sqlite
cp -r ../loot-core/migrations build/loot-core/migrations
